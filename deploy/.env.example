# Cau hinh cho ban trien khai that. Chep thanh deploy/.env roi dien lai.
# Tep deploy/.env KHONG duoc dua len git (da nam trong .gitignore).

# Ten mien da tro ve IP cua may chu. Chua co ten mien thi dung dich vu mien phi
# nhu DuckDNS (vi du fams-dnu.duckdns.org) - xem deploy/README.md.
FAMS_DOMAIN=fams-dnu.duckdns.org

# Khoa ky token dang nhap va URL anh bang chung. BAT BUOC doi, khong dung lai gia tri mau.
# Sinh khoa moi:  openssl rand -hex 32
SECRET_KEY=thay-bang-chuoi-ngau-nhien-64-ky-tu

# Tai khoan cua co so du lieu. Mat khau nay chi dung ben trong Docker, nhung van phai
# dat manh vi no nam trong bien moi truong cua container.
POSTGRES_USER=fams
POSTGRES_PASSWORD=thay-bang-mat-khau-manh
POSTGRES_DB=fams

TZ=Asia/Ho_Chi_Minh

# Gui ma OTP quen mat khau. De trong thi he thong chi ghi ma ra log, nguoi dung
# khong nhan duoc email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@fams.edu.vn
