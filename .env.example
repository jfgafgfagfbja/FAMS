# Bien cho docker-compose.yml o goc du an (docker compose tu doc file ".env"
# cung thu muc). Copy thanh ".env" va sua truoc khi chay `docker compose up`.

# --- Database (service "db") ---
POSTGRES_USER=fams
POSTGRES_PASSWORD=fams123
POSTGRES_DB=fams

# --- Backend (service "backend") ---
TZ=Asia/Ho_Chi_Minh
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai-truoc-khi-len-production
# Them origin cua Flutter web khi chay dev (flutter run -d chrome --web-port 5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Quen mat khau (OTP qua email) - de trong SMTP_HOST de chay o che do DEV: OTP se
# duoc log ra console (docker compose logs backend) thay vi gui email that.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@fams.edu.vn

# VITE_API_URL cua frontend duoc co dinh la /api (proxy qua nginx, xem
# frontend/nginx.conf) nen khong can khai bao o day.
